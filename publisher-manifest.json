f;padding:2px 8px;margin-bottom:8px}\n.price{font-size:30px;font-weight:800;letter-spacing:-.02em;line-height:1.1}\n.price small{font-size:13px;font-weight:600;color:var(--mute);letter-spacing:0}\n.annual{font-size:13px;color:var(--violet-deep);font-weight:700;margin-top:6px}\n.plan-feat ul{columns:1;font-size:14.5px;color:var(--ink-soft)}\n.plan-feat li::marker{color:var(--violet)}\n.plan-note{grid-column:1/-1;margin-top:16px;padding-top:12px;border-top:1px dashed var(--line);font-size:13px;color:var(--mute)}\n\n/* ---- clients ---- */\n.clients{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}\n.client{border:1px dashed var(--line);background:var(--panel);padding:18px}\n.client h3{font-size:16.5px;margin-bottom:6px}\n.client .plat{font-size:11.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--violet-deep);font-weight:700;margin-bottom:10px}\n.client p{font-size:14px;color:var(--ink-soft);margin:0 0 10px}\n.client .link{font-size:13.5px}\n\n/* ---- notes list ---- */\n.notes{display:grid;grid-template-columns:1fr 1fr;gap:12px}\n.note-card{border:1px dashed var(--line);background:var(--panel);padding:18px}\n.note-card h3{font-size:16px;margin-bottom:8px}\n.note-card p{font-size:14px;color:var(--ink-soft);margin:0}\n\n/* ---- FAQ details ---- */\ndetails.faq{border:1px dashed var(--line);background:var(--panel);padding:0;margin-bottom:10px}\ndetails.faq[open]{border-color:var(--violet);background:#fff}\ndetails.faq summary{cursor:pointer;list-style:none;padding:15px 18px;font-weight:700;font-size:15.5px;display:flex;gap:12px;align-items:baseline}\ndetails.faq summary::-webkit-details-marker{display:none}\ndetails.faq summary::before{content:\"+\";color:var(--violet);font-weight:800;width:14px;flex:none}\ndetails.faq[open] summary::before{content:\"–\"}\ndetails.faq .answer{padding:0 18px 16px 44px;font-size:14.5px;color:var(--ink-soft)}\ndetails.faq .answer p:last-child{margin-bottom:0}\n\n.foot{margin-top:60px;border-top:1px solid var(--line);padding-top:20px;font-size:13px;color:var(--mute);display:flex;flex-wrap:wrap;gap:8px 22px;justify-content:space-between}\n.foot a{color:var(--ink-soft);border-bottom:none}\n.foot a:hover{color:var(--violet-deep);text-decoration:underline;text-underline-offset:3px}\n\n@media (max-width:860px){\n  .dash{grid-template-columns:repeat(2,1fr)}\n  .tile.wide{grid-column:span 2}\n  .steps{grid-template-columns:1fr}\n  .clients{grid-template-columns:1fr}\n  .notes{grid-template-columns:1fr}\n  .plan{grid-template-columns:1fr;gap:14px}\n}\n@media (max-width:520px){\n  body{font-size:15.5px}\n  .wrap{padding:0 16px 60px}\n  .topbar-in{padding:12px 16px}\n  .dash{grid-template-columns:1fr}\n  .tile.wide{grid-column:span 1}\n  .hero{padding-top:32px}\n  .price{font-size:26px}\n}\n</style><div class=\"topbar\">\n  <div class=\"topbar-in\">\n    <a class=\"wordmark\" href=\"#top\">TIGER<span>.</span></a>\n    <nav class=\"jump\" aria-label=\"页面内跳转\">\n      <a href=\"#plans\">套餐</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#howto\">使用步骤</a>\n      <a href=\"#faq\">常见问题</a>\n    </nav>\n  </div>\n</div>\n\n<main class=\"wrap\" id=\"top\">\n\n  <header class=\"hero\">\n    <div class=\"hero-lead\">\n      <div class=\"hero-kicker\">订阅总览 / TIGER</div>\n      <h1>TIGER 把订阅、<em>客户端</em>与使用步骤一次说清</h1>\n      <p>这一页按清单方式组织：先看套餐块，再确认设备与客户端，最后按步骤落地。所有价格、流量与设备数量直接写在对应套餐卡片里，不做额外承诺。</p>\n    </div>\n\n    <div class=\"dash\" aria-label=\"关键信息速览\">\n      <div class=\"tile\">\n        <div class=\"k\">套餐档位</div>\n        <div class=\"v\">3 <small>档</small></div>\n        <div class=\"n\">基础版 / 旗舰版 / 团队版，单列依次展开。</div>\n      </div>\n      <div class=\"tile\">\n        <div class=\"k\">月起价</div>\n        <div class=\"v\">¥15 <small>/ 月</small></div>\n        <div class=\"n\">基础版月付价格，年付价格见套餐卡片。</div>\n      </div>\n      <div class=\"tile\">\n        <div class=\"k\">同时在线</div>\n        <div class=\"v\">3–20 <small>台</small></div>\n        <div class=\"n\">按档位不同，以套餐权益列写为准。</div>\n      </div>\n      <div class=\"tile\">\n        <div class=\"k\">年付折算</div>\n        <div class=\"v\">10 <small>个月额度</small></div>\n        <div class=\"n\">三档年付价格均为月付价格的 10 倍。</div>\n      </div>\n      <div class=\"tile wide accent\">\n        <div class=\"k\">旗舰版</div>\n        <div class=\"v\">¥35 <small>/ 月 · 年付 ¥350</small></div>\n        <div class=\"n\">300GB 流量、5 台设备、全节点原生流媒体解锁、IPLC 专线游戏加速优化与优先工单支持。</div>\n      </div>\n      <div class=\"tile\">\n        <div class=\"k\">客户端</div>\n        <div class=\"v\">3 <small>类平台</small></div>\n        <div class=\"n\">桌面、移动、路由器场景分别说明。</div>\n      </div>\n      <div class=\"tile\">\n        <div class=\"k\">常见问题</div>\n        <div class=\"v\">6 <small>条</small></div>\n        <div class=\"n\">折叠展开，按问题直接查看答案。</div>\n      </div>\n    </div>\n  </header>\n\n  <section id=\"plans\">\n    <div class=\"sec-head\">\n      <span class=\"sec-tag\">01 / Plans</span>\n      <h2>订阅套餐：三档依次往下看</h2>\n    </div>\n    <p class=\"lede\">按月付价格从低到高排列。年付价格在每张卡片内单独标出，按年付与按月付的权益条目一致，区别只在计费周期。</p>\n\n    <div class=\"plans\">\n      <article class=\"plan\">\n        <div>\n          <div class=\"plan-name\">基础版</div>\n          <div class=\"price\">¥15<small> / 月</small></div>\n          <div class=\"annual\">按年付 ¥150 / 年</div>\n        </div>\n        <div class=\"plan-feat\">\n          <ul>\n            <li>每月 100GB 流量</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>解锁基础流媒体</li>\n            <li>普通线路节点池</li>\n          </ul>\n        </div>\n        <div class=\"plan-note\">适合单人或少量设备、用量可预期的日常场景。</div>\n      </article>\n\n      <article class=\"plan featured\">\n        <div>\n          <div class=\"badge\">推荐档位</div>\n          <div class=\"plan-name\">旗舰版</div>\n          <div class=\"price\">¥35<small> / 月</small></div>\n          <div class=\"annual\">按年付 ¥350 / 年</div>\n        </div>\n        <div class=\"plan-feat\">\n          <ul>\n            <li>每月 300GB 流量</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7x24 优先工单支持</li>\n          </ul>\n        </div>\n        <div class=\"plan-note\">在三档中设备数与流量较为均衡，含优先工单支持。</div>\n      </article>\n\n      <article class=\"plan\">\n        <div>\n          <div class=\"plan-name\">团队版</div>\n          <div class=\"price\">¥85<small> / 月</small></div>\n          <div class=\"annual\">按年付 ¥850 / 年</div>\n        </div>\n        <div class=\"plan-feat\">\n          <ul>\n            <li>每月 1000GB 流量</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n        </div>\n        <div class=\"plan-note\">面向多人共用或设备较多的组织，含定制路由与专属客户经理。</div>\n      </article>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"sec-head\">\n      <span class=\"sec-tag\">02 / Clients</span>\n      <h2>客户端准备：按你的设备对号入座</h2>\n    </div>\n    <p class=\"lede\">下面按平台类型说明需要在本地准备什么、在哪里配置。本页不提供安装包下载地址，请以你实际获得的客户端说明为准。</p>\n\n    <div class=\"clients\">\n      <article class=\"client\">\n        <div class=\"plat\">桌面端</div>\n        <h3>Windows / macOS</h3>\n        <p>在电脑上使用，适合长时间在线与多窗口工作。进入客户端后填写订阅信息，再选择普通线路或专线节点。</p>\n        <p class=\"link\"><a href=\"#howto\">查看配置步骤 →</a></p>\n      </article>\n      <article class=\"client\">\n        <div class=\"plat\">移动端</div>\n        <h3>iOS / Android</h3>\n        <p>手机与平板使用，适合随身上网。安装后导入订阅信息，注意核对同时在线设备数是否已达到套餐上限。</p>\n        <p class=\"link\"><a href=\"#faq\">设备数量怎么算 →</a></p>\n      </article>\n      <article class=\"client\">\n        <div class=\"plat\">路由器 / 多设备</div>\n        <h3>网络出口侧配置</h3>\n        <p>把出口放在路由器侧，可让同网络下的设备共用一条出口。设备数仍以套餐同时在线上限为准。</p>\n        <p class=\"link\"><a href=\"#plans\">对比设备数量 →</a></p>\n      </article>\n    </div>\n  </section>\n\n  <section id=\"howto\">\n    <div class=\"sec-head\">\n      <span class=\"sec-tag\">03 / How to use</span>\n      <h2>使用步骤：三步完成第一次连接</h2>\n    </div>\n    <div class=\"steps\">\n      <article class=\"step\">\n        <span class=\"num\">STEP 01</span>\n        <h3>确认订阅与计费周期</h3>\n        <p>先在套餐区确认档位、月付或年付价格，以及流量与设备数量的上限，再进入下一步。</p>\n      </article>\n      <article class=\"step\">\n        <span class=\"num\">STEP 02</span>\n        <h3>在客户端填写订阅信息</h3>\n        <p>打开对应平台的客户端，按界面提示填入订阅信息并保存。填写完成后先不急着切换节点。</p>\n      </article>\n      <article class=\"step\">\n        <span class=\"num\">STEP 03</span>\n        <h3>选择线路并核对状态</h3>\n        <p>按用途选择普通线路或专线节点，连接后核对当前生效的节点与设备数是否符合你的档位。</p>\n      </article>\n    </div>\n\n    <div class=\"notes\">\n      <article class=\"note-card\">\n        <h3>计费与续费</h3>\n        <p>三档年付价格均为对应月付价格的 10 倍。续费前建议先核对当前周期的剩余时间与所需档位。</p>\n      </article>\n      <article class=\"note-card\">\n        <h3>线路与用途</h3>\n        <p>基础版为普通线路节点池，旗舰版含 IPLC 专线游戏加速优化，团队版为 VIP 专属高带宽节点。选线路时按实际用途取舍。</p>\n      </article>\n      <article class=\"note-card\">\n        <h3>设备数量</h3>\n        <p>同时在线上限分别为 3 台、5 台、20 台。多设备共用出口时，请按真实在线设备数计算。</p>\n      </article>\n      <article class=\"note-card\">\n        <h3>支持渠道</h3>\n        <p>旗舰版含 7x24 优先工单支持，团队版含专属客户经理服务。基础版按常规工单流程处理。</p>\n      </article>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"sec-head\">\n      <span class=\"sec-tag\">04 / FAQ</span>\n      <h2>常见问题</h2>\n    </div>\n\n    <details class=\"faq\">\n      <summary>三档套餐的主要区别是什么？</summary>\n      <div class=\"answer\">\n        <p>主要是流量、同时在线设备数、线路与支持四项。基础版为 100GB、3 台、普通线路节点池；旗舰版为 300GB、5 台、全节点原生流媒体解锁与 IPLC 专线游戏加速优化，并含 7x24 优先工单支持；团队版为 1000GB、20 台、VIP 专属高带宽节点，支持企业定制路由与专属客户经理服务。</p>\n      </div>\n    </details>\n\n    <details class=\"faq\">\n      <summary>年付和月付的价格怎么换算？</summary>\n      <div class=\"answer\">\n        <p>按页面标价，基础版 ¥15/月、年付 ¥150/年；旗舰版 ¥35/月、年付 ¥350/年；团队版 ¥85/月、年付 ¥850/年。三档年付金额均等于对应月付价格的 10 倍。除计费周期外，权益条目一致。</p>\n      </div>\n    </details>\n\n    <details class=\"faq\">\n      <summary>同时在线设备数怎么计算？</summary>\n      <div class=\"answer\">\n        <p>按同一时间处于在线状态的设备数量计算，不看历史登录次数。基础版 3 台、旗舰版 5 台、团队版 20 台。若在路由器侧配置出口供多台设备共用，这些设备仍计入在线数量。</p>\n      </div>\n    </details>\n\n    <details class=\"faq\">\n      <summary>流量是每月重置还是按周期累计？</summary>\n      <div class=\"answer\">\n        <p>页面标注的是“每月”流量额度，即每个计费周期对应一个额度。超出额度后的处理方式页面未作说明，请在订阅前以你实际看到的服务条款为准，本页不额外承诺。</p>\n      </div>\n    </details>\n\n    <details class=\"faq\">\n      <summary>本页是否提供客户端下载链接？</summary>\n      <div class=\"answer\">\n        <p>不提供。本页只说明需要在桌面端、移动端或路由器侧准备什么、如何填写订阅信息与选择线路，不放置安装包地址。请以你实际获得的客户端来源为准。</p>\n      </div>\n    </details>\n\n    <details class=\"faq\">\n      <summary>遇到连接问题应该先检查什么？</summary>\n      <div class=\"answer\">\n        <p>按顺序核对三件事：订阅信息是否完整填入客户端、当前所选节点是否属于你套餐可用的线路类型、在线设备数是否超过档位上限。三项都确认后再通过对应档位的支持渠道反馈，反馈时附上客户端平台与所选线路。</p>\n      </div>\n    </details>\n  </section>\n\n  <div class=\"foot\">\n    <span>TIGER · 订阅套餐、客户端与使用说明</span>\n    <span>\n      <a href=\"#plans\">套餐</a> ·\n      <a href=\"#clients\">客户端</a> ·\n      <a href=\"#howto\">使用步骤</a> ·\n      <a href=\"#faq\">常见问题</a>\n    </span>\n  </div>\n\n</main>",
